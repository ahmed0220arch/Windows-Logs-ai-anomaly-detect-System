# --- Database ---
DATABASE_URL=postgresql://postgres:admin@localhost/pfe_project

# --- Email Alerts (SMTP via Gmail) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@neopolis.com

# --- AI Diagnostic Assistant (Optional) ---
GROK_API_KEY=
